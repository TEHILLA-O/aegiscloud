{
  "name": "aegiscloud",
  "version": "1.0.0",
  "description": "AegisCloud — AWS self-healing infrastructure, security and operations platform",
  "private": true,
  "bin": {
    "aegis": "cli/aegis/bin/aegis.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "cdk": "cdk",
    "synth": "cdk synth -c env=dev",
    "synth:prod": "cdk synth -c env=production-demo",
    "diff": "cdk diff -c env=dev",
    "deploy:dev": "cdk deploy --all -c env=dev --require-approval never",
    "deploy:prod-demo": "cdk deploy --all -c env=production-demo",
    "destroy:dev": "cdk destroy --all -c env=dev --force",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "aegis": "ts-node --prefer-ts-exts cli/aegis/src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-config-service": "^3.700.0",
    "@aws-sdk/client-cost-explorer": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-ecs": "^3.700.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.700.0",
    "@aws-sdk/client-guardduty": "^3.700.0",
    "@aws-sdk/client-rds": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-securityhub": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-cdk-lib": "^2.178.1",
    "commander": "^12.1.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "aws-cdk": "^2.178.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
